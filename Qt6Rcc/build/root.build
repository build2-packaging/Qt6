using in

# Compile as C++17 with GNU extensions (-std=gnu++17 with GCC and Clang), like
# upstream (see qt_set_language_standards() in
# upstream/qtbase/cmake/QtFlagHandlingHelpers.cmake; the c++20 and later
# features in upstream/qtbase/configure.cmake are not autodetected). In
# particular, Qt must be compiled in a mode that enables 128-bit integers if
# the compiler supports them (see
# upstream/qtbase/src/corelib/global/qtypes.cpp).
#
using cxx.guess

cxx.std = ($cxx.class == 'gcc' ? 'gnu++17' : '17')

using cxx

hxx{*}: extension = h
cxx{*}: extension = cpp

# Assume headers are importable unless stated otherwise.
#
hxx{*}: cxx.importable = true

using cxx.objcxx

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target

if ($build.mode != 'skeleton')
  source build/common.build
